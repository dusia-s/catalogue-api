# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Tests must not depend on Mailpit being reachable. The null transport still runs
# every Mailer listener, so MailerAssertionsTrait sees the messages that were sent.
MAILER_DSN=null://null

# The database name gets a `_test` suffix from config/packages/doctrine.yaml, so
# this points at `catalogue_test`, which docker/mysql/init.sql creates and grants.
